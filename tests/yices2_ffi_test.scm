(module yices2-ffi-test
        (import (yices2-ffi "yices2_ffi.scm"))
        (main main))

(define *checks* 0)

(define-macro (check want expression)
  `(let* ((expected ,want)
          (actual ,expression))
     (set! *checks* (+ *checks* 1))
     (unless (if (and (number? expected) (number? actual))
                 (= expected actual)
                 (equal? expected actual))
       (error 'yices2-ffi-test "Unexpected result"
              (list ',expression 'expected expected 'actual actual)))))

(define-macro (allocate kind c-type count)
  `(,(symbol-append 'pragma:: kind) ,(string-append "(" c-type " *) GC_MALLOC(sizeof(" c-type ") * $1)") ,count))

(define-macro (array-set! ptr index value)
  `(pragma::void "$1[$2] = $3" ,ptr ,index ,value))

(define-macro (at kind ptr index)
  `(,(symbol-append 'pragma:: kind) "$1[$2]" ,ptr ,index))

(define-macro (present? ptr)
  `(pragma::bool "$1 != NULL" ,ptr))

(define-macro (when-available name . body)
  `(unless (memq ',name (yices-api-missing-functions)) ,@body))

(define (terms . values)
  (let ((array (allocate yices-term-pointer "term_t" (length values))))
    (let loop ((index::long 0) (values values))
      (unless (null? values)
        (let ((value::int32 (car values)))
          (array-set! array index value))
        (loop (+ index 1) (cdr values))))
    array))

(define (fresh type)
  (yices-new-uninterpreted-term type))

(define-macro (vector-count vector)
  `(pragma::uint32 "$1->size" ,vector))

(define (take-string pointer)
  (let ((copy (yices-string-copy pointer)))
    (yices-free-string pointer)
    copy))

(define (test-metadata-and-errors)
  (for-each (lambda (s) (check #t (> (string-length s) 0)))
            (list (yices-const-string-copy yices-version)
                  (yices-const-string-copy yices-build-arch)
                  (yices-const-string-copy yices-build-mode)
                  (yices-const-string-copy yices-build-date)))
  (check #t (<= 0 (yices-has-mcsat) 1))
  (check #t (<= 0 (yices-is-thread-safe) 1))
  ;; Restore the default callback without triggering an out-of-memory condition.
  (yices-set-out-of-mem-callback (pragma::yices-oom-callback "NULL"))
  (check -1 (yices-parse-term "("))
  (check #t (> (yices-error-code) 0))
  (check #t (present? (yices-error-report)))
  (check #t (> (string-length (take-string (yices-error-string))) 0))
  (let* ((file (pragma::yices-FILE-pointer "tmpfile()"))
         (fd (pragma::int "fileno($1)" file)))
    (check 0 (yices-print-error file))
    (check 0 (yices-print-error-fd fd))
    (check 0 (pragma::int "fclose($1)" file)))
  (yices-clear-error)
  (check 0 (yices-error-code)))

(define (test-types)
  (let* ((bool (yices-bool-type))
         (int (yices-int-type))
         (real (yices-real-type))
         (bv (yices-bv-type 8))
         (scalar (yices-new-scalar-type 3))
         (sort (yices-new-uninterpreted-type))
         (array (allocate yices-type-pointer "type_t" 3))
         (vector (allocate yices-type-vector-pointer "type_vector_t" 1)))
    (array-set! array 0 bool)
    (array-set! array 1 int)
    (array-set! array 2 real)
    (let* ((tuple (yices-tuple-type 3 array))
           (fun (yices-function-type 3 array bv)))
      (check tuple (yices-tuple-type3 bool int real))
      (check (yices-tuple-type 2 array) (yices-tuple-type2 bool int))
      (check (yices-tuple-type 1 array) (yices-tuple-type1 bool))
      (check fun (yices-function-type3 bool int real bv))
      (check (yices-function-type 2 array bv) (yices-function-type2 bool int bv))
      (check (yices-function-type 1 array bv) (yices-function-type1 bool bv))
      (check 1 (yices-type-is-bool bool))
      (check 1 (yices-type-is-int int))
      (check 1 (yices-type-is-real real))
      (check 1 (yices-type-is-arithmetic int))
      (check 1 (yices-type-is-bitvector bv))
      (check 1 (yices-type-is-tuple tuple))
      (check 1 (yices-type-is-function fun))
      (check 1 (yices-type-is-scalar scalar))
      (check 1 (yices-type-is-uninterpreted sort))
      (check 1 (yices-test-subtype int real))
      (check 1 (yices-compatible-types real int))
      (check 0 (yices-compatible-types bool real))
      (check 8 (yices-bvtype-size bv))
      (check 3 (yices-scalar-type-card scalar))
      (check 3 (yices-type-num-children tuple))
      (check int (yices-type-child tuple 1))
      (yices-init-type-vector vector)
      (check 0 (yices-type-children tuple vector))
      (check 3 (vector-count vector))
      (check real (pragma::int32 "$1->data[2]" vector))
      (yices-reset-type-vector vector)
      (check 0 (vector-count vector))
      (yices-delete-type-vector vector))
    (let* ((constructor (yices-type-constructor "ffi_constructor" 1))
           (var (yices-type-variable 0)))
      (array-set! array 0 var)
      (let ((alias (yices-type-macro "ffi_alias" 1 array (yices-tuple-type1 var))))
        (array-set! array 0 int)
        (check alias (yices-get-macro-by-name "ffi_alias"))
        (check #t (>= (yices-instance-type constructor 1 array) 0))
        (check (yices-tuple-type1 int) (yices-instance-type alias 1 array))
        (yices-remove-type-macro-name "ffi_alias")
        (check -1 (yices-get-macro-by-name "ffi_alias"))
        (yices-delete-type-macro alias)
        (yices-delete-type-macro constructor)))
    (check int (yices-parse-type "int"))
    (check 0 (yices-set-type-name sort "ffi_sort"))
    (check "ffi_sort" (yices-const-string-copy (yices-get-type-name sort)))
    (check sort (yices-get-type-by-name "ffi_sort"))
    (yices-remove-type-name "ffi_sort")
    (check -1 (yices-get-type-by-name "ffi_sort"))
    (check 0 (yices-clear-type-name sort))
    (check #f (yices-const-string-copy (yices-get-type-name sort)))))

(define (test-terms)
  (let* ((bool (yices-bool-type))
         (int (yices-int-type))
         (t (yices-true))
         (f (yices-false))
         (p (fresh bool))
         (q (fresh bool))
         (x (yices-new-variable bool))
         (args (terms p q t))
         (fun1 (fresh (yices-function-type1 bool int)))
         (fun2 (fresh (yices-function-type2 bool bool int)))
         (fun3 (fresh (yices-function-type3 bool bool bool int)))
         (zero (yices-zero))
         (tuple (yices-triple p q t)))
    (check (yices-application1 fun1 p) (yices-application fun1 1 args))
    (check (yices-application2 fun2 p q) (yices-application fun2 2 args))
    (check (yices-application3 fun3 p q t) (yices-application fun3 3 args))
    (check (yices-update1 fun1 p zero) (yices-update fun1 1 args zero))
    (check (yices-update2 fun2 p q zero) (yices-update fun2 2 args zero))
    (check (yices-update3 fun3 p q t zero) (yices-update fun3 3 args zero))
    (check p (yices-ite t p q))
    (check t (yices-eq p p))
    (check f (yices-neq q q))
    (check f (yices-not t))
    (check t (yices-or 3 (terms p q t)))
    (check (yices-or2 p q) (yices-or3 p q f))
    (check (yices-and2 p q) (yices-and 3 (terms p q t)))
    (check (yices-and2 p q) (yices-and3 p q t))
    (check (yices-xor2 p q) (yices-xor3 p q f))
    (check t (yices-xor 3 (terms t f f)))
    (check t (yices-iff p p))
    (check f (yices-implies t f))
    (check tuple (yices-tuple 3 args))
    (check (yices-pair p q) (yices-tuple 2 args))
    (check q (yices-select 2 tuple))
    (check (yices-triple p f t) (yices-tuple-update tuple 2 f))
    (check t (yices-distinct 2 (terms t f)))
    (check 1 (yices-term-is-ground (yices-forall 1 (terms x) x)))
    (check 1 (yices-term-is-ground (yices-exists 1 (terms x) x)))
    (check p (yices-application1 (yices-lambda 1 (terms x) x) p))
    (check f (yices-subst-term 1 (terms x) (terms f) (yices-and2 x p)))
    (let ((forms (terms x (yices-or2 x p))))
      (check 0 (yices-subst-term-array 1 (terms x) (terms f) 2 forms))
      (check f (at int32 forms 0))
      (check p (at int32 forms 1)))
    (check 0 (yices-set-term-name p "ffi_prop"))
    (check p (yices-get-term-by-name "ffi_prop"))
    (check p (yices-parse-term "ffi_prop"))
    (check "ffi_prop" (yices-const-string-copy (yices-get-term-name p)))
    (yices-remove-term-name "ffi_prop")
    (check -1 (yices-get-term-by-name "ffi_prop"))
    (check 0 (yices-clear-term-name p))
    (check #f (yices-const-string-copy (yices-get-term-name p)))
    (check bool (yices-type-of-term p))
    (check 1 (yices-term-is-bool p))
    (check 1 (yices-term-is-int zero))
    (check 1 (yices-term-is-real (yices-rational32 1 2)))
    (check 1 (yices-term-is-arithmetic zero))
    (check 1 (yices-term-is-bitvector (yices-bvconst-zero 8)))
    (check 1 (yices-term-is-tuple tuple))
    (check 1 (yices-term-is-function fun1))
    (let* ((scalar (yices-new-scalar-type 3))
           (constant (yices-constant scalar 2))
           (out (allocate yices-int32-pointer "int32_t" 1)))
      (check 1 (yices-term-is-scalar constant))
      (check 0 (yices-scalar-const-value constant out))
      (check 2 (at int32 out 0))
      (check 0 (yices-bool-const-value t out))
      (check 1 (at int32 out 0)))
    (check 1 (yices-term-is-atomic p))
    (check 1 (yices-term-is-composite tuple))
    (check (pragma::int "YICES_TUPLE_TERM") (yices-term-constructor tuple))
    (check 3 (yices-term-num-children tuple))
    (check q (yices-term-child tuple 1))
    (let ((vector (allocate yices-term-vector-pointer "term_vector_t" 1)))
      (yices-init-term-vector vector)
      (check 0 (yices-term-children tuple vector))
      (check 3 (vector-count vector))
      (check t (pragma::int32 "$1->data[2]" vector))
      (yices-reset-term-vector vector)
      (check 0 (vector-count vector))
      (yices-delete-term-vector vector))
    (let* ((target (fresh (yices-tuple-type2 bool int)))
           (selection (yices-select 1 target)))
      (check 1 (yices-term-is-projection selection))
      (check 1 (yices-proj-index selection))
      (check target (yices-proj-arg selection)))))

(define (test-arithmetic)
  (let* ((two (yices-int32 2))
         (three (yices-int64 3))
         (half (yices-rational32 1 2))
         (t (yices-true))
         (f (yices-false))
         (x (fresh (yices-real-type)))
         (y (fresh (yices-real-type)))
         (terms23 (terms two three))
         (a32 (allocate yices-int32-pointer "int32_t" 2))
         (d32 (allocate yices-uint32-pointer "uint32_t" 2))
         (a64 (allocate yices-int64-pointer "int64_t" 2))
         (d64 (allocate yices-uint64-pointer "uint64_t" 2))
         (integers (allocate yices-mpz-array "mpz_t" 2))
         (rationals (allocate yices-mpq-array "mpq_t" 2))
         (z (pragma::yices-mpz "&$1[0][0]" integers))
         (r (pragma::yices-mpq "&$1[0][0]" rationals)))
    (check half (yices-rational64 1 2))
    (check half (yices-parse-rational "1/2"))
    (check half (yices-parse-float "0.5"))
    (check (yices-parse-rational "-9007199254740997")
           (yices-int64 #s64:-9007199254740997))
    (check (yices-parse-rational "1/18446744073709551615")
           (yices-rational64 1 (pragma::uint64 "UINT64_MAX")))
    (check (yices-int32 5) (yices-add two three))
    (check (yices-int32 5) (yices-sum 2 terms23))
    (check (yices-int32 1) (yices-sub three two))
    (check (yices-int32 -2) (yices-neg two))
    (check (yices-int32 6) (yices-mul two three))
    (check (yices-int32 6) (yices-product 2 terms23))
    (check (yices-int32 4) (yices-square two))
    (check (yices-int32 8) (yices-power two 3))
    (check (yices-rational32 3 2) (yices-division three two))
    (check (yices-int32 1) (yices-idiv three two))
    (check (yices-int32 1) (yices-imod three two))
    (check t (yices-divides-atom two (yices-int32 4)))
    (check f (yices-is-int-atom half))
    (check half (yices-abs (yices-neg half)))
    (check (yices-zero) (yices-floor half))
    (check (yices-int32 1) (yices-ceil half))
    (check t (yices-arith-eq-atom two two))
    (check t (yices-arith-neq-atom two three))
    (check t (yices-arith-geq-atom three two))
    (check t (yices-arith-leq-atom two three))
    (check t (yices-arith-gt-atom three two))
    (check t (yices-arith-lt-atom two three))
    (check f (yices-arith-eq0-atom two))
    (check t (yices-arith-neq0-atom two))
    (check t (yices-arith-geq0-atom two))
    (check f (yices-arith-leq0-atom two))
    (check t (yices-arith-gt0-atom two))
    (check f (yices-arith-lt0-atom two))
    (array-set! a32 0 4) (array-set! a32 1 -1)
    (array-set! a64 0 4) (array-set! a64 1 -1)
    (array-set! d32 0 2) (array-set! d32 1 1)
    (array-set! d64 0 2) (array-set! d64 1 1)
    (check (yices-int32 5) (yices-poly-int32 2 a32 terms23))
    (check (yices-int32 5) (yices-poly-int64 2 a64 terms23))
    (check (yices-int32 1) (yices-poly-rational32 2 a32 d32 terms23))
    (check (yices-int32 1) (yices-poly-rational64 2 a64 d64 terms23))
    (pragma::void "mpz_init_set_si($1[0], 4), mpz_init_set_si($1[1], -1)" integers)
    (pragma::void "mpq_init($1[0]), mpq_init($1[1]), mpq_set_si($1[0], 2, 1), mpq_set_si($1[1], -1, 1)" rationals)
    (check (yices-int32 4) (yices-mpz z))
    (check two (yices-mpq r))
    (check (yices-int32 5) (yices-poly-mpz 2 integers terms23))
    (check (yices-int32 1) (yices-poly-mpq 2 rationals terms23))
    (check 0 (yices-rational-const-value half r))
    (check 0 (pragma::int "mpq_cmp_si($1, 1, 2)" r))
    (let ((sum (yices-add x y))
          (product (yices-mul x y))
          (term (allocate yices-term-pointer "term_t" 1))
          (exp (allocate yices-uint32-pointer "uint32_t" 1)))
      (check 1 (yices-term-is-sum sum))
      (check 0 (yices-sum-component sum 0 r term))
      (check #t (or (= (at int32 term 0) x) (= (at int32 term 0) y)))
      (check 0 (pragma::int "mpq_cmp_si($1, 1, 1)" r))
      (check 1 (yices-term-is-product product))
      (check 0 (yices-product-component product 0 term exp))
      (check 1 (at uint32 exp 0)))
    (when-available yices-finitefield-const-value
      ;; An integer term is rejected by the finite-field constant accessor.
      (check -1 (yices-finitefield-const-value two z)))
    (check (yices-bvconst-uint32 8 4) (yices-bvconst-mpz 8 z))
    (pragma::void "mpz_clear($1[1]), mpz_clear($1[0])" integers)
    (pragma::void "mpq_clear($1[1]), mpq_clear($1[0])" rationals)))

(define (test-bitvectors)
  (let* ((a (yices-bvconst-uint32 4 6))
         (b (yices-bvconst-uint64 4 2))
         (zero (yices-bvconst-zero 4))
         (one (yices-bvconst-one 4))
         (ones (yices-bvconst-minus-one 4))
         (bits (allocate yices-int32-pointer "int32_t" 4))
         (t (yices-true))
         (f (yices-false))
         (v (fresh (yices-bv-type 4)))
         (w (fresh (yices-bv-type 4))))
    (check one (yices-bvconst-int32 4 1))
    (check ones (yices-bvconst-int64 4 -1))
    (check a (yices-parse-bvbin "0110"))
    (check a (yices-parse-bvhex "6"))
    (check 4 (yices-term-bitsize a))
    (check 0 (yices-bv-const-value a bits))
    (check 0 (at int32 bits 0))
    (check 1 (at int32 bits 1))
    (check 1 (at int32 bits 2))
    (check 0 (at int32 bits 3))
    (check a (yices-bvconst-from-array 4 bits))
    (check (yices-bvconst-uint32 4 8) (yices-bvadd a b))
    (check (yices-bvconst-uint32 4 4) (yices-bvsub a b))
    (check (yices-bvconst-uint32 4 10) (yices-bvneg a))
    (check (yices-bvconst-uint32 4 12) (yices-bvmul a b))
    (check (yices-bvconst-uint32 4 4) (yices-bvsquare a))
    (check (yices-bvconst-uint32 4 8) (yices-bvpower b 3))
    (check (yices-bvconst-uint32 4 3) (yices-bvdiv a b))
    (check zero (yices-bvrem a b))
    (check (yices-bvconst-int32 4 -3) (yices-bvsdiv (yices-bvneg a) b))
    (check (yices-bvconst-int32 4 -1) (yices-bvsrem ones b))
    (check one (yices-bvsmod ones b))
    (check (yices-bvconst-uint32 4 9) (yices-bvnot a))
    (check (yices-bvnot b) (yices-bvnand a b))
    (check (yices-bvnot a) (yices-bvnor a b))
    (check (yices-bvconst-uint32 4 11) (yices-bvxnor a b))
    (check (yices-bvconst-uint32 4 8) (yices-bvshl a b))
    (check one (yices-bvlshr a b))
    (check ones (yices-bvashr ones b))
    (check b (yices-bvand 2 (terms a b)))
    (check a (yices-bvor 2 (terms a b)))
    (check (yices-bvconst-uint32 4 4) (yices-bvxor 2 (terms a b)))
    (check b (yices-bvand2 a b))
    (check a (yices-bvor2 a b))
    (check (yices-bvconst-uint32 4 4) (yices-bvxor2 a b))
    (check b (yices-bvand3 a b ones))
    (check a (yices-bvor3 a b zero))
    (check a (yices-bvxor3 a b b))
    (check (yices-bvadd a b) (yices-bvsum 2 (terms a b)))
    (check (yices-bvmul a b) (yices-bvproduct 2 (terms a b)))
    (check (yices-bvconst-uint32 4 12) (yices-shift-left0 a 1))
    (check (yices-bvconst-uint32 4 13) (yices-shift-left1 a 1))
    (check (yices-bvconst-uint32 4 3) (yices-shift-right0 a 1))
    (check (yices-bvconst-uint32 4 11) (yices-shift-right1 a 1))
    (check ones (yices-ashift-right ones 1))
    (check (yices-bvconst-uint32 4 12) (yices-rotate-left a 1))
    (check (yices-bvconst-uint32 4 3) (yices-rotate-right a 1))
    (check (yices-bvconst-uint32 2 3) (yices-bvextract a 1 2))
    (check (yices-bvconst-uint32 8 98) (yices-bvconcat2 a b))
    (check (yices-bvconcat2 a b) (yices-bvconcat 2 (terms a b)))
    (check (yices-bvconst-uint32 8 102) (yices-bvrepeat a 2))
    (check (yices-bvconst-minus-one 8) (yices-sign-extend ones 4))
    (check (yices-bvconst-uint32 8 15) (yices-zero-extend ones 4))
    (check (yices-bvconst-one 1) (yices-redand ones))
    (check (yices-bvconst-one 1) (yices-redor a))
    (check (yices-bvconst-zero 1) (yices-redcomp a b))
    (check a (yices-bvarray 4 (terms f t t f)))
    (check t (yices-bitextract a 1))
    (check t (yices-bveq-atom a a))
    (check t (yices-bvneq-atom a b))
    (check t (yices-bvge-atom a b))
    (check t (yices-bvgt-atom a b))
    (check t (yices-bvle-atom b a))
    (check t (yices-bvlt-atom b a))
    (check t (yices-bvsge-atom a ones))
    (check t (yices-bvsgt-atom a ones))
    (check t (yices-bvsle-atom ones a))
    (check t (yices-bvslt-atom ones a))
    (let ((sum (yices-bvadd v w))
          (term (allocate yices-term-pointer "term_t" 1)))
      (check 1 (yices-term-is-bvsum sum))
      (check 0 (yices-bvsum-component sum 0 bits term))
      (check #t (or (= (at int32 term 0) v) (= (at int32 term 0) w)))
      (check 1 (at int32 bits 0))
      (check 0 (at int32 bits 1)))))

(define (test-garbage-collection)
  (let ((sort (yices-new-uninterpreted-type))
        (keep-sort (yices-new-uninterpreted-type))
        (x (fresh (yices-int-type)))
        (keep-x (fresh (yices-bool-type)))
        (types (allocate yices-type-pointer "type_t" 1)))
    (array-set! types 0 keep-sort)
    (check 0 (yices-incref-term x))
    (check 0 (yices-incref-type sort))
    (check 1 (yices-num-posref-terms))
    (check 1 (yices-num-posref-types))
    (check #t (> (yices-num-terms) 2))
    (check #t (> (yices-num-types) 2))
    (yices-garbage-collect (terms keep-x) 1 types 1 0)
    (check 1 (yices-term-is-int x))
    (check 1 (yices-type-is-uninterpreted sort))
    (check 1 (yices-term-is-bool keep-x))
    (check 1 (yices-type-is-uninterpreted keep-sort))
    (check 0 (yices-decref-term x))
    (check 0 (yices-decref-type sort))
    (check 0 (yices-num-posref-terms))
    (check 0 (yices-num-posref-types))))

(define-macro (status suffix)
  `(pragma::int ,(string-append "YICES_STATUS_" (symbol->string suffix))))

(define (test-context)
  (let* ((config (yices-new-config))
         (params (yices-new-param-record))
         (p (fresh (yices-bool-type)))
         (q (fresh (yices-bool-type))))
    (check 0 (yices-default-config-for-logic config "QF_UF"))
    (check 0 (yices-set-config config "mode" "push-pop"))
    (let ((ctx (yices-new-context config)))
      (check #t (present? ctx))
      (yices-free-config config)
      (check (status IDLE) (yices-context-status ctx))
      (yices-default-params-for-context ctx params)
      (check 0 (yices-set-param params "random-seed" "42"))
      (check 0 (yices-context-enable-option ctx "var-elim"))
      (check 0 (yices-context-disable-option ctx "var-elim"))
      (check 0 (yices-assert-formula ctx p))
      (check 0 (yices-push ctx))
      (check 0 (yices-assert-formulas ctx 2 (terms (yices-not p) q)))
      (check (status UNSAT) (yices-check-context ctx params))
      (check 0 (yices-pop ctx))
      (check (status SAT) (yices-check-context ctx params))
      (let ((model (yices-get-model ctx 1)))
        (check (yices-true) (yices-get-value-as-term model p))
        (yices-free-model model))
      (check 0 (yices-assert-blocking-clause ctx))
      (check (status UNSAT) (yices-check-context ctx params))
      (yices-reset-context ctx)
      (check (status IDLE) (yices-context-status ctx))
      (yices-stop-search ctx)
      (check 0 (yices-assert-formula ctx p))
      (let ((not-p (yices-not p))
            (core (allocate yices-term-vector-pointer "term_vector_t" 1)))
        (check (status UNSAT)
               (yices-check-context-with-assumptions ctx params 2 (terms not-p q)))
        (yices-init-term-vector core)
        (check 0 (yices-get-unsat-core ctx core))
        (check 1 (vector-count core))
        (check not-p (pragma::int32 "$1->data[0]" core))
        (yices-delete-term-vector core))
      (yices-free-context ctx))
    (yices-free-param-record params)))

(define (test-direct-checks)
  (let* ((p (fresh (yices-bool-type)))
         (not-p (yices-not p))
         (model (allocate yices-model-pointer-pointer "model_t *" 1))
         (delegate (pragma::string "NULL"))
         (status-out (allocate yices-smt-status-pointer "smt_status_t" 1))
         (file "yices2_ffi_test.cnf"))
    (check 1 (yices-has-delegate delegate))
    (check 0 (yices-has-delegate "no-such-delegate"))
    (check (status SAT) (yices-check-formula p "QF_BV" model delegate))
    (yices-free-model (at yices-model-pointer model 0))
    (check (status UNSAT) (yices-check-formulas (terms p not-p) 2 "QF_BV" model delegate))
    (check 1 (yices-export-formula-to-dimacs p file 0 status-out))
    (check #t (file-exists? file))
    (delete-file file)
    (check 0 (yices-export-formulas-to-dimacs (terms p not-p) 2 file 0 status-out))
    (check (status UNSAT) (at int status-out 0))))

(define (test-model)
  (let* ((bool (yices-bool-type))
         (int (yices-int-type))
         (real (yices-real-type))
         (bv (yices-bv-type 4))
         (sort (yices-new-scalar-type 3))
         (p (fresh bool))
         (x (fresh int))
         (r (fresh real))
         (b (fresh bv))
         (s (fresh sort))
         (t (yices-true))
         (seven (yices-int32 7))
         (half (yices-rational32 1 2))
         (bits (yices-bvconst-uint32 4 6))
         (scalar (yices-constant sort 1))
         (vars (terms p x r b s))
         (model (yices-model-from-map 5 vars (terms t seven half bits scalar)))
         (i32 (allocate yices-int32-pointer "int32_t" 4))
         (i64 (allocate yices-int64-pointer "int64_t" 1))
         (u32 (allocate yices-uint32-pointer "uint32_t" 1))
         (u64 (allocate yices-uint64-pointer "uint64_t" 1))
         (dbl (allocate yices-double-pointer "double" 1))
         (z (allocate yices-mpz "__mpz_struct" 1))
         (q (allocate yices-mpq "__mpq_struct" 1))
         (value (allocate yices-yval-pointer "yval_t" 1))
         (type-out (allocate yices-type-pointer "type_t" 1))
         (vector (allocate yices-term-vector-pointer "term_vector_t" 1))
         (formula (yices-and2 p (yices-arith-gt0-atom x))))
    (check #t (present? model))
    (pragma::void "mpz_init($1)" z)
    (pragma::void "mpq_init($1)" q)
    (check 0 (yices-get-bool-value model p i32))
    (check 1 (at int32 i32 0))
    (check 0 (yices-get-int32-value model x i32))
    (check 7 (at int32 i32 0))
    (check 0 (yices-get-int64-value model x i64))
    (check 7 (at int64 i64 0))
    (check 0 (yices-get-rational32-value model r i32 u32))
    (check 1 (at int32 i32 0))
    (check 2 (at uint32 u32 0))
    (check 0 (yices-get-rational64-value model r i64 u64))
    (check 1 (at int64 i64 0))
    (check 2 (at uint64 u64 0))
    (check 0 (yices-get-double-value model r dbl))
    (check 0.5 (at double dbl 0))
    (check 0 (yices-get-mpz-value model x z))
    (check 7 (pragma::long "mpz_get_si($1)" z))
    (check 0 (yices-get-mpq-value model r q))
    (check 0 (pragma::int "mpq_cmp_si($1, 1, 2)" q))
    (check 0 (yices-get-scalar-value model s i32))
    (check 1 (at int32 i32 0))
    (check 0 (yices-get-bv-value model b i32))
    (check 1 (at int32 i32 2))

    (check 0 (yices-get-value model x value))
    (check 1 (yices-val-is-int32 model value))
    (check 1 (yices-val-is-int64 model value))
    (check 1 (yices-val-is-rational32 model value))
    (check 1 (yices-val-is-rational64 model value))
    (check 1 (yices-val-is-integer model value))
    (check 0 (yices-val-get-int32 model value i32))
    (check 7 (at int32 i32 0))
    (check 0 (yices-val-get-int64 model value i64))
    (check 7 (at int64 i64 0))
    (check 0 (yices-val-get-mpz model value z))
    (check 7 (pragma::long "mpz_get_si($1)" z))
    (check 0 (yices-get-value model r value))
    (check 0 (yices-val-get-rational32 model value i32 u32))
    (check 1 (at int32 i32 0))
    (check 2 (at uint32 u32 0))
    (check 0 (yices-val-get-rational64 model value i64 u64))
    (check 1 (at int64 i64 0))
    (check 2 (at uint64 u64 0))
    (check 0 (yices-val-get-double model value dbl))
    (check 0.5 (at double dbl 0))
    (check 0 (yices-val-get-mpq model value q))
    (check 0 (pragma::int "mpq_cmp_si($1, 1, 2)" q))
    (let ((null-a (pragma::yices-algebraic-number "NULL")))
      (when-available yices-get-algebraic-number-value
        (check -1 (yices-get-algebraic-number-value model r null-a)))
      (when-available yices-val-get-algebraic-number
        (check -1 (yices-val-get-algebraic-number model value null-a)))
      (when-available yices-model-set-algebraic-number
        (check -1 (yices-model-set-algebraic-number model -1 null-a))))
    (check 0 (yices-get-value model p value))
    (check 0 (yices-val-get-bool model value i32))
    (check 1 (at int32 i32 0))
    (check 0 (yices-get-value model b value))
    (check 4 (yices-val-bitsize model value))
    (check 0 (yices-val-get-bv model value i32))
    (check 1 (at int32 i32 2))
    (check 0 (yices-get-value model s value))
    (check 0 (yices-val-get-scalar model value i32 type-out))
    (check 1 (at int32 i32 0))
    (check sort (at int32 type-out 0))

    (check 1 (yices-formula-true-in-model model formula))
    (check 1 (yices-formulas-true-in-model model 2 (terms p formula)))
    (check 0 (yices-formula-true-in-model model (yices-not p)))
    (check half (yices-get-value-as-term model r))
    (let ((values (allocate yices-term-pointer "term_t" 5)))
      (check 0 (yices-term-array-value model 5 vars values))
      (check seven (at int32 values 1))
      (check scalar (at int32 values 4)))
    (yices-init-term-vector vector)
    (check 0 (yices-model-term-support model formula vector))
    (check 2 (vector-count vector))
    (yices-reset-term-vector vector)
    (check 0 (yices-model-term-array-support model 2 (terms r b) vector))
    (check 2 (vector-count vector))
    (yices-reset-term-vector vector)
    (check 0 (yices-implicant-for-formula model formula vector))
    (check 2 (vector-count vector))
    (yices-reset-term-vector vector)
    (check 0 (yices-implicant-for-formulas model 2 (terms p formula) vector))
    (check 2 (vector-count vector))
    (let ((mode (pragma::int "YICES_GEN_BY_SUBST"))
          (eliminate (terms p)))
      (yices-reset-term-vector vector)
      (check 0 (yices-generalize-model model formula 1 eliminate mode vector))
      (check 1 (vector-count vector))
      (check (yices-arith-gt0-atom x) (pragma::int32 "$1->data[0]" vector))
      (yices-reset-term-vector vector)
      (check 0 (yices-generalize-model-array model 2 (terms p formula) 1 eliminate mode vector))
      (check (yices-arith-gt0-atom x)
             (yices-and (vector-count vector) (pragma::yices-term-pointer "$1->data" vector))))
    (yices-delete-term-vector vector)

    (let ((copy (yices-new-model))
          (a (fresh int))
          (c (fresh real)))
      (check 0 (yices-model-set-bool copy (fresh bool) 1))
      (check 0 (yices-model-set-int32 copy a 7))
      (check seven (yices-get-value-as-term copy a))
      (check 0 (yices-model-set-int64 copy (fresh int) 9))
      (check 0 (yices-model-set-rational32 copy (fresh real) 1 2))
      (check 0 (yices-model-set-rational64 copy (fresh real) 1 2))
      (check 0 (yices-model-set-mpz copy (fresh int) z))
      (check 0 (yices-model-set-mpq copy (fresh real) q))
      (check 0 (yices-model-set-bv-int32 copy (fresh bv) -1))
      (check 0 (yices-model-set-bv-int64 copy (fresh bv) -1))
      (check 0 (yices-model-set-bv-uint32 copy (fresh bv) 6))
      (check 0 (yices-model-set-bv-uint64 copy (fresh bv) 6))
      (check 0 (yices-model-set-bv-mpz copy (fresh bv) z))
      (check 0 (yices-model-set-bv-from-array copy (fresh bv) 4 i32))
      (check 0 (yices-model-set-scalar copy (fresh sort) 1))
      (check 0 (yices-model-set-double copy c 0.5))
      (check half (yices-get-value-as-term copy c))
      (check 0 (yices-model-set-float copy (fresh real) 0.5))
      (check 0 (yices-model-set-term copy (fresh bool) t))
      (check 0 (yices-get-value copy a value))
      (check 0 (yices-model-set-yval copy (fresh int) value))
      (yices-free-model copy))
    (pragma::void "mpz_clear($1)" z)
    (pragma::void "mpq_clear($1)" q)
    (yices-free-model model)))

(define (test-structured-values)
  (let* ((int (yices-int-type))
         (type (yices-function-type1 int int))
         (tuple-type (yices-tuple-type2 int int))
         (fun (fresh type))
         (one (yices-int32 1))
         (two (yices-int32 2))
         (three (yices-int32 3))
         (four (yices-int32 4))
         (ctx (yices-new-context (pragma::yices-ctx-config-pointer "NULL")))
         (a (yices-application1 fun one))
         (b (yices-application1 fun three))
         (formulas (terms (yices-eq a two) (yices-eq b four))))
    (check 0 (yices-assert-formulas ctx 2 formulas))
    (check (status SAT) (yices-check-context ctx (pragma::yices-param-pointer "NULL")))
    (let* ((model (yices-get-model ctx 1))
           (value (allocate yices-yval-pointer "yval_t" 1))
           (entries (allocate yices-yval-pointer "yval_t" 2))
           (second (pragma::yices-yval-pointer "$1 + 1" entries))
           (result (allocate yices-yval-pointer "yval_t" 1))
           (def (allocate yices-yval-pointer "yval_t" 1))
           (vector (allocate yices-yval-vector-pointer "yval_vector_t" 1))
           (int-out (allocate yices-int32-pointer "int32_t" 1))
           (tuple (yices-pair one two)))
      (check 0 (yices-get-value model tuple value))
      (check 2 (yices-val-tuple-arity model value))
      (check 0 (yices-val-expand-tuple model value entries))
      (check 0 (yices-val-get-int32 model second int-out))
      (check 2 (at int32 int-out 0))

      (check 0 (yices-get-value model fun value))
      (check 1 (yices-val-function-arity model value))
      (check type (yices-val-function-type model value))
      (yices-init-yval-vector vector)
      (check 0 (yices-val-expand-function model value def vector))
      (check #t (> (vector-count vector) 0))
      (let ((entry (pragma::yices-yval-pointer "$1->data" vector)))
        (check 1 (yices-val-mapping-arity model entry))
        (check 0 (yices-val-expand-mapping model entry entries result))
        (check 0 (yices-val-get-int32 model result int-out))
        (check #t (or (= 2 (at int32 int-out 0)) (= 4 (at int32 int-out 0)))))
      (yices-reset-yval-vector vector)
      (check 0 (vector-count vector))
      (yices-delete-yval-vector vector)

      (check 0 (yices-get-value model one entries))
      (check 0 (yices-get-value model two second))
      (when-available yices-model-make-tuple
        (check 0 (yices-model-make-tuple model 2 entries value))
        (check 2 (yices-val-tuple-arity model value)))
      (when-available yices-model-set-tuple
        (let ((var (fresh tuple-type)))
          (check 0 (yices-model-set-tuple model var 2 entries))
          (check tuple (yices-get-value-as-term model var))))
      (when-available yices-model-make-mapping
        (check 0 (yices-model-make-mapping model 1 entries second result))
        (check 1 (yices-val-mapping-arity model result))
        (check 0 (yices-get-value model three def))
        (when-available yices-model-make-function
          (check 0 (yices-model-make-function model type 1 result def value))
          (check type (yices-val-function-type model value)))
        (when-available yices-model-set-function
          (let ((var (fresh type)))
            (check 0 (yices-model-set-function model var 1 result def))
            (check two (yices-get-value-as-term model (yices-application1 var one)))
            (check three (yices-get-value-as-term model (yices-application1 var two))))))
      (yices-free-model model))
    (yices-free-context ctx)))

(define (test-printing)
  (let* ((int (yices-int-type))
         (x (fresh int))
         (one (yices-int32 1))
         (ctx (yices-new-context (pragma::yices-ctx-config-pointer "NULL")))
         (file (pragma::yices-FILE-pointer "tmpfile()"))
         (fd (pragma::int "fileno($1)" file))
         (array (terms x one)))
    (check 0 (yices-set-term-name x "ffi_print_x"))
    (check 0 (yices-assert-formula ctx (yices-arith-gt-atom x one)))
    (check (status SAT) (yices-check-context ctx (pragma::yices-param-pointer "NULL")))
    (let ((model (yices-get-model ctx 1))
          (defined (allocate yices-term-vector-pointer "term_vector_t" 1)))
      (yices-init-term-vector defined)
      (yices-model-collect-defined-terms model defined)
      (check 1 (vector-count defined))
      (check x (pragma::int32 "$1->data[0]" defined))
      (yices-delete-term-vector defined)
      (check "int" (take-string (yices-type-to-string int 80 10 0)))
      (check "1" (take-string (yices-term-to-string one 80 10 0)))
      (check #t (> (string-length (take-string (yices-model-to-string model 80 10 0))) 0))
      (check 0 (yices-pp-type file int 80 10 0))
      (check 0 (yices-pp-term file x 80 10 0))
      (check 0 (yices-pp-term-array file 2 array 80 10 0 1))
      (yices-print-model file model)
      (check 0 (yices-pp-model file model 80 10 0))
      (check 0 (yices-print-term-values file model 2 array))
      (check 0 (yices-pp-term-values file model 2 array 80 10 0))
      (check 0 (pragma::int "fflush($1)" file))
      (check 0 (yices-pp-type-fd fd int 80 10 0))
      (check 0 (yices-pp-term-fd fd x 80 10 0))
      (check 0 (yices-pp-term-array-fd fd 2 array 80 10 0 1))
      (check 0 (yices-print-model-fd fd model))
      (check 0 (yices-pp-model-fd fd model 80 10 0))
      (check 0 (yices-print-term-values-fd fd model 2 array))
      (check 0 (yices-pp-term-values-fd fd model 2 array 80 10 0))
      (check 0 (pragma::int "fclose($1)" file))
      (yices-free-model model))
    (yices-free-context ctx)))

(define (test-model-interpolation)
  (let* ((mcsat? (= (yices-has-mcsat) 1))
         (x (fresh (yices-real-type)))
         (vars (terms x))
         (two (yices-int32 2))
         (three (yices-int32 3))
         (model (yices-model-from-map 1 vars (terms three)))
         (config (yices-new-config))
         (null-params (pragma::yices-param-pointer "NULL"))
         (right (yices-new-context (pragma::yices-ctx-config-pointer "NULL")))
         (interpolation (allocate yices-interpolation-context-pointer "interpolation_context_t" 1)))
    (check 0 (yices-set-term-name x "ffi_interpolation_x"))
    (when mcsat?
      (check 0 (yices-default-config-for-logic config "QF_NRA"))
      (check 0 (yices-set-config config "mode" "push-pop"))
      (check 0 (yices-set-config config "model-interpolation" "true")))
    (let ((left (yices-new-context config))
          (expected (if mcsat? (status UNSAT) (status ERROR)))
          (order-status (if mcsat? (status IDLE) (status ERROR))))
      (check #t (present? left))
      (yices-free-config config)
      (check 0 (yices-assert-formula left (yices-arith-lt-atom x two)))
      (check 0 (yices-assert-formula right (yices-eq x three)))
      (check order-status (yices-mcsat-set-fixed-var-order left 1 vars))
      (check order-status (yices-mcsat-set-initial-var-order left 1 vars))
      (check expected (yices-check-context-with-model left null-params model 1 vars))
      (let ((clause (yices-get-model-interpolant left)))
        (if mcsat?
            (check 0 (yices-formula-true-in-model model clause))
            (check -1 clause)))
      (yices-reset-context left)
      (check 0 (yices-assert-formula left (yices-arith-lt-atom x two)))
      (check expected (yices-check-context-with-model-and-hint left null-params model 1 vars 1))
      (yices-reset-context left)
      (check 0 (yices-assert-formula left (yices-arith-lt-atom x two)))
      (pragma::void "$1->ctx_A = $2, $1->ctx_B = $3" interpolation left right)
      (let ((result (yices-check-context-with-interpolation interpolation null-params 0)))
        (when (and mcsat? (= result (status ERROR)))
          (error 'yices-check-context-with-interpolation
                 (take-string (yices-error-string)) result))
        (check expected result))
      (when mcsat?
        (let ((interpolant (pragma::int32 "$1->interpolant" interpolation)))
          (check 0 (yices-formula-true-in-model model interpolant))))
      (yices-free-context left)
      (yices-free-context right)
      (yices-free-model model))))

(define (main args)
  (dynamic-wind
    (lambda () (yices-init))
    (lambda ()
      (test-metadata-and-errors)
      (test-types)
      (test-terms)
      (test-arithmetic)
      (test-bitvectors)
      (test-context)
      (test-direct-checks)
      (test-model)
      (test-structured-values)
      (test-printing)
      (test-model-interpolation)
      (test-garbage-collection)
      (yices-reset)
      (check 0 (yices-error-code)))
    (lambda () (yices-exit)))
  (print "Yices2 " (yices-const-string-copy yices-version) ": " *checks* " checks passed")
  (unless (null? (yices-api-missing-functions))
    (print "Unavailable API functions: " (yices-api-missing-functions)))
  0)
