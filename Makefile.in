SAL_SCM_FILE = $(SAL_CORE_SCM_FILE) $(SAL_SPECIFIC_SCM_FILE)

SALENV_SPECIFIC_SCM_FILE= salenv

ALL_SCM_FILE = $(SAL_CORE_SCM_FILE) $(SAL_SPECIFIC_SCM_FILE)  \
 $(SAL_PARSER_SPECIFIC_SCM_FILE) $(SALENV_SPECIFIC_SCM_FILE)

ALL_SCM_SRC = $(ALL_SCM_FILE:%=$(SRC_DIR)/%.scm)

SAL_C_CORE_FILE= gmp_scheme_interface.c file-info-imp.c pid_info.c  \
runtime-support.c

SAL_C_FILE = $(SAL_C_CORE_FILE) state_entry.c state_entry_channel.c \
state_cache.c jenkins_hash.c bit_array.c random-support.c           \
cudd_c_utils.c state_to_do_list.c

SALENV_SAFE= $(SALENV)-safe
SALENV_SCM_FILE = $(SAL_SCM_FILE) $(SALENV_SPECIFIC_SCM_FILE)
SALENV_SCM_OBJ = $(SALENV_SCM_FILE:%=$(OBJ_DIR)/%.o)
SALENV_SAFE_SCM_OBJ = $(SALENV_SCM_FILE:%=$(OBJ_SAFE_DIR)/%.o)
SALENV_C_OBJ = $(SAL_C_FILE:%.c=$(OBJ_DIR)/%.o)
SALENV_MCO = $(SALENV_SCM_FILE:%=$(OBJ_DIR)/%.mco)
SALENV_OBJ = $(SALENV_SCM_OBJ) $(SALENV_C_OBJ)
SALENV_SAFE_OBJ = $(SALENV_SAFE_SCM_OBJ) $(SALENV_C_OBJ)
SALENV_BIN = $(BIN_DIR)/$(SALENV)
SALENV_SAFE_BIN = $(BIN_DIR)/$(SALENV_SAFE)

SALHEAP=sal.heap
SALHEAP_DEST = $(LIB_DIR)/$(SALHEAP)

SALRUNTIME = libsal_u
SALRUNTIME_SAFE = libsal_s
SALRUNTIME_LIB = $(LIB_DIR)/$(SALRUNTIME).a
SALRUNTIME_SAFE_LIB = $(LIB_DIR)/$(SALRUNTIME_SAFE).a
SALRUNTIME_SCM_FILE = $(SAL_SCM_FILE)
SALRUNTIME_SCM_OBJ = $(SALRUNTIME_SCM_FILE:%=$(OBJ_DIR)/%.o)
SALRUNTIME_SAFE_SCM_OBJ = $(SALRUNTIME_SCM_FILE:%=$(OBJ_SAFE_DIR)/%.o)
SALRUNTIME_C_OBJ = $(SAL_C_FILE:%.c=$(OBJ_DIR)/%.o)
SALRUNTIME_OBJ = $(SALRUNTIME_SCM_OBJ) $(SALRUNTIME_C_OBJ)
SALRUNTIME_SAFE_OBJ = $(SALRUNTIME_SAFE_SCM_OBJ) $(SALRUNTIME_C_OBJ)

SAL_PARSER=sal-parser
SAL_PARSER_BIN=$(BIN_DIR)/$(SAL_PARSER)
SAL_PARSER_SCM_OBJ=$(SAL_PARSER_SCM_FILE:%=$(OBJ_DIR)/%.o)
SAL_PARSER_C_OBJ=$(SAL_C_CORE_FILE:%.c=$(OBJ_DIR)/%.o)
SAL_PARSER_OBJ=$(SAL_PARSER_SCM_OBJ) $(SAL_PARSER_C_OBJ)

SAL_CDR=sal-cdr-exec
SAL_CDR_BIN=$(BIN_DIR)/$(SAL_CDR)
SAL_CDR_SCM_OBJ=$(OBJ_DIR)/sal-cdr-front-end.o $(OBJ_DIR)/sal-cdr.o
SAL_CDR_OBJ=$(SAL_CDR_SCM_OBJ) $(YICES2_FFI_OBJ)

.PHONY: all install-local

ifeq ($(SALENV_BUILD_MODE),release)
TARGETS = $(SALENV_SAFE) $(SALENV) $(SALHEAP) $(SAL_PARSER) $(SALRUNTIME_SAFE) $(SALRUNTIME)
else
TARGETS = $(SALENV) $(SALENV_SAFE) $(SALHEAP) $(SAL_PARSER) $(SALRUNTIME)
endif

TARGETS += $(SAL_CDR)

all: $(TARGETS) local-install

# Native Yices2 bindings, shared by sal-cdr and standalone FFI clients.
# After changing the Yices installation/flags, refresh optional API detection:
#   make -B YICES2_PREFIX=/new/prefix yices2-ffi
# Then rebuild sal-cdr-exec with the same prefix.
YICES2_PREFIX ?= $(HOMEBREW_PREFIX)
YICES2_CPPFLAGS ?= $(if $(YICES2_PREFIX),-I$(YICES2_PREFIX)/include)
YICES2_LDFLAGS ?= $(if $(YICES2_PREFIX),-L$(YICES2_PREFIX)/lib -Xlinker -rpath -Xlinker $(YICES2_PREFIX)/lib)
# Bind an explicit prefix to its library even when Bigloo adds other -L paths.
YICES2_LIBRARY = $(if $(YICES2_PREFIX),$(firstword $(wildcard $(YICES2_PREFIX)/lib/libyices.dylib $(YICES2_PREFIX)/lib/libyices.so)))
YICES2_LIBS ?= $(if $(YICES2_LIBRARY),$(YICES2_LIBRARY),-lyices) -lgmp
# SAL already links its private static GMP; adding -lgmp here would override it.
YICES2_SAL_LIBS = $(filter-out -lgmp,$(YICES2_LIBS))
YICES2_FFI_DIR = $(abspath $(OBJ_DIR)/yices2-ffi)
YICES2_FFI_SRC = $(YICES2_FFI_DIR)/yices2_ffi.scm
YICES2_FFI_OBJ = $(YICES2_FFI_DIR)/yices2_ffi.o
YICES2_FFI_MCO = $(YICES2_FFI_DIR)/yices2_ffi.mco
YICES2_FFI_ENV = YICES2_FFI_CC="$(CC) $(YICES2_CPPFLAGS) $(CPPFLAGS)" \
                YICES2_FFI_LINK="$(YICES2_LDFLAGS) $(LDFLAGS) $(YICES2_LIBS)"
YICES2_FFI_FLAGS = -copt "$(YICES2_CPPFLAGS) $(CPPFLAGS)"

.PHONY: yices2-ffi test-yices2-ffi
$(YICES2_FFI_DIR)/yices2-ffi-generator: $(SRC_DIR)/yices2-ffi-generator.scm
	@mkdir -p "$(YICES2_FFI_DIR)"
	$(BIGLOO) -c "$<" -o "$(YICES2_FFI_DIR)/yices2-ffi-generator.o"
	$(BIGLOO) -I "$(abspath $(SRC_DIR))" -ldopt "$(LDFLAGS)" \
	  "$(YICES2_FFI_DIR)/yices2-ffi-generator.o" -o "$@"

yices2-ffi: $(YICES2_FFI_OBJ) $(YICES2_FFI_MCO)

$(YICES2_FFI_SRC): $(YICES2_FFI_DIR)/yices2-ffi-generator $(SRC_DIR)/yices2_api.spec
	cd "$(YICES2_FFI_DIR)" && $(YICES2_FFI_ENV) \
	  ./yices2-ffi-generator "$(abspath $(SRC_DIR)/yices2_api.spec)"

$(YICES2_FFI_OBJ): $(YICES2_FFI_SRC)
	cd "$(YICES2_FFI_DIR)" && $(BIGLOO) $(OPT) $(YICES2_FFI_FLAGS) \
	  -c yices2_ffi.scm -o yices2_ffi.o

$(YICES2_FFI_MCO): $(YICES2_FFI_SRC)
	cd "$(YICES2_FFI_DIR)" && $(BIGLOO) -fmco -mco yices2_ffi.scm -o yices2_ffi.mco

# Complete the shared generated files before launching recursive builds.
ifeq ($(MAKELEVEL),0)
$(SAL_CDR): yices2-ffi
# Recursive builds share object/dependency files. Build each object tree once,
# then allow the independent archives and heap to finish in parallel.
ifeq ($(SALENV_BUILD_MODE),release)
$(SALENV): $(SALENV_SAFE)
else
$(SALENV_SAFE): $(SALENV)
endif
$(SALHEAP) $(SALRUNTIME) $(SAL_PARSER): $(SALENV)
$(SALRUNTIME_SAFE): $(SALENV_SAFE)
$(SAL_CDR): $(SALRUNTIME)
endif

test-yices2-ffi: yices2-ffi
	cd "$(YICES2_FFI_DIR)" && $(BIGLOO) $(YICES2_FFI_FLAGS) \
	  -c "$(abspath tests/yices2_ffi_test.scm)" -o yices2_ffi_test.o && \
	  $(BIGLOO) -I "$(abspath tests)" -w -ldopt "$(YICES2_LDFLAGS) $(LDFLAGS) $(YICES2_LIBS)" \
	  yices2_ffi_test.o yices2_ffi.o -o yices2_ffi_test && ./yices2_ffi_test

local-install: $(TARGETS)
	@ chmod +x install/local-install.sh
	@ ./install/local-install.sh

#*---------------------------------------------------------------------*/
#*  Binaries                                                           */
#*---------------------------------------------------------------------*/

#
# SALENV
#
ifeq ($(MAKELEVEL),1)
# This is a correctness precondition, not just a linker preference: sharing
# SAL's GC-backed GMP allocator with native solver heaps corrupts ownership.
.PHONY: check-sal-private-gmp
check-sal-private-gmp:
	@case "$(posixos)" in darwin|linux) ;; *) echo "sal-cdr native GMP isolation is supported on Darwin and Linux only." >&2; exit 1 ;; esac
	@test -n "$(YICES2_LIBRARY)" && test -f "$(YICES2_LIBRARY)" || { echo "sal-cdr requires a shared Yices2 library; set YICES2_PREFIX or YICES2_LIBRARY to its installation." >&2; exit 1; }
	@case "$(YICES2_LIBRARY)" in *.so|*.so.*|*.dylib) ;; *) echo "sal-cdr requires a shared Yices2 library, not $(YICES2_LIBRARY)." >&2; exit 1 ;; esac
	@test -n "$(SAL_GMP_ARCHIVES)" || { echo "SAL native solver links require the configured static libgmp.a; do not replace LIBS with -lgmp." >&2; exit 1; }
	@for library in $(LIBS) $(YICES2_SAL_LIBS) $(LDFLAGS) $(YICES2_LDFLAGS); do \
	  case "$${library##*/}" in \
	    libyices*.a|libpoly*.a|-l:libyices*.a|-l:libpoly*.a) \
	      echo "sal-cdr requires shared Yices2/libpoly libraries, not $$library." >&2; exit 1 ;; \
	    -lgmp|libgmp.so|libgmp.so.*|libgmp.dylib|libgmp.*.dylib) \
	      echo "SAL native solver links require private static GMP, not $$library." >&2; exit 1 ;; \
	  esac; \
	done

$(SAL_CDR_BIN): LIBS := $(SAL_LINK_LIBS)
$(SAL_CDR_BIN): | check-sal-private-gmp
$(SALENV) : $(SALENV_BIN)

ifeq ($(SALENV_BUILD_MODE),release)
SALENV_BIN_DEPENDENCIES= compilation-support-code.scm $(SALENV_OBJ)
else
SALENV_BIN_DEPENDENCIES= $(SALENV_OBJ)
endif

$(SALENV_BIN) : $(SALENV_BIN_DEPENDENCIES)
	@mkdir -p $(BIN_DIR)
	$(BIGLOO) $(BIGLOO_UNSAFE_LFLAGS) $(SALENV_OBJ) -o $(SALENV_BIN)
else
$(SALENV) : 
	make -C src -f ../Makefile $(SALENV) MAKELEVEL=1
endif

# Native sal-cdr uses the same SAL runtime, parser, and command-line options.
ifeq ($(MAKELEVEL),1)
$(SAL_CDR): $(SAL_CDR_BIN)

$(SAL_CDR_BIN): $(SAL_CDR_OBJ) $(SALRUNTIME_LIB)
	@mkdir -p $(BIN_DIR)
	$(BIGLOO) -ldopt "$(YICES2_LDFLAGS)" $(BIGLOO_UNSAFE_LFLAGS) -I "$(YICES2_FFI_DIR)" -ldopt "$(YICES2_SAL_LIBS)" $(SAL_CDR_OBJ) $(SALRUNTIME_LIB) -o $@
else
$(SAL_CDR):
	make -C src -f ../Makefile $(SAL_CDR) MAKELEVEL=1
endif

#
# SALENV SAFE
#
ifeq ($(MAKELEVEL),1)
$(SALENV_SAFE) : $(SALENV_SAFE_BIN)

ifeq ($(SALENV_BUILD_MODE),release)
$(SALENV_SAFE_BIN) : $(SALENV_SAFE_OBJ)
	@mkdir -p $(BIN_DIR)
	$(BIGLOO) $(BIGLOO_SAFE_LFLAGS) $(SALENV_SAFE_OBJ) -o $(SALENV_SAFE_BIN)
else
# Only in release mode I create a safe executable
$(SALENV_SAFE_BIN) : $(SALENV_BIN)
		@mkdir -p $(BIN_DIR)
		rm -f $(SALENV_SAFE_BIN)
		cp $(SALENV_BIN)$(EXEEXT) $(SALENV_SAFE_BIN)$(EXEEXT)
endif
else
$(SALENV_SAFE) :
	make -C src -f ../Makefile $(SALENV_SAFE) MAKELEVEL=1
endif

#
# SALHEAP
#
ifeq ($(MAKELEVEL),1)
$(SALHEAP) : $(SALHEAP_DEST)

$(SALHEAP_DEST) : $(SALENV_OBJ) make-lib.scm
	@mkdir -p $(LIB_DIR)
	$(BIGLOO) -unsafe -q -mkaddheap -mkaddlib make-lib.scm -addheap $(SALHEAP_DEST) -heap-library sal
else
$(SALHEAP) : 
	make -C src -f ../Makefile $(SALHEAP) MAKELEVEL=1
endif

#
# SALRUNTIME Library
#
ifeq ($(MAKELEVEL),1)

$(SALRUNTIME) : $(SALRUNTIME_LIB)

$(SALRUNTIME_LIB) : $(SALRUNTIME_OBJ)
	rm -f $(SALRUNTIME_LIB)
	$(AR) qcv $(SALRUNTIME_LIB) $(SALRUNTIME_OBJ)
	$(RANLIB) $(SALRUNTIME_LIB)

else

$(SALRUNTIME) :
	make -C src -f ../Makefile $(SALRUNTIME) MAKELEVEL=1

endif

#
# SALRUNTIME safe Library
#
ifeq ($(MAKELEVEL),1)

$(SALRUNTIME_SAFE) : $(SALRUNTIME_SAFE_LIB)

$(SALRUNTIME_SAFE_LIB) : $(SALRUNTIME_SAFE_OBJ)
	rm -f $(SALRUNTIME_SAFE_LIB)
	$(AR) qcv $(SALRUNTIME_SAFE_LIB) $(SALRUNTIME_SAFE_OBJ)
	$(RANLIB) $(SALRUNTIME_SAFE_LIB)

else

$(SALRUNTIME_SAFE) :
	make -C src -f ../Makefile $(SALRUNTIME_SAFE) MAKELEVEL=1

endif

#
# SAL-PARSER
#
ifeq ($(MAKELEVEL),1)
$(SAL_PARSER) : $(SAL_PARSER_BIN)

$(SAL_PARSER_BIN) : $(SAL_PARSER_OBJ)
	@mkdir -p $(BIN_DIR)
	$(BIGLOO) $(BIGLOO_UNSAFE_LFLAGS) $(SAL_PARSER_OBJ) -o $(SAL_PARSER_BIN)
else
$(SAL_PARSER) : 
	make -C src -f ../Makefile $(SAL_PARSER) MAKELEVEL=1
endif

#*---------------------------------------------------------------------*/
#*    Code analyzer                                                    */
#*---------------------------------------------------------------------*/
ifeq ($(MAKELEVEL),1)
code-analyzer: code-analyzer.scm
	bigloo -o code-analyzer code-analyzer.scm -ldopt "$(LDFLAGS)"

compilation-support-code.scm: code-analyzer $(SALENV_SAFE_BIN)
	(SAL_COLLECT_CLASS_INFO=true; export SAL_COLLECT_CLASS_INFO; $(SALENV_SAFE_BIN) -V)
	./code-analyzer
else
code-analyzer:
	make -C src -f ../Makefile code-analyzer MAKELEVEL=1
compilation-support-code.scm:
	make -C src -f ../Makefile compilation-support-code.scm MAKELEVEL=1
endif

#*---------------------------------------------------------------------*/
#*    Auxiliary                                                        */
#*---------------------------------------------------------------------*/
ifeq ($(posixos),linux)
Makefile: Makefile.in config.status
	./config.status
	make MAKELEVEL=0
endif
ifeq ($(posixos),linux)
config.status: configure
	./config.status --recheck
endif

#*---------------------------------------------------------------------*/
#*    .scm.o                                                           */
#*---------------------------------------------------------------------*/
# Native sources are deliberately outside ALL_SCM_SRC: building a legacy
# SAL executable must not generate or link Yices2. The runtime archive supplies
# its module checksums before native compilation, including a clean build.
$(SAL_CDR_SCM_OBJ): $(SALRUNTIME_LIB) $(YICES2_FFI_MCO)
$(SAL_CDR_SCM_OBJ): CPPFLAGS := $(YICES2_CPPFLAGS) $(CPPFLAGS)
$(SAL_CDR_SCM_OBJ): BIGLOO_FLAGS_DEFAULT += -I "$(YICES2_FFI_DIR)"
$(OBJ_DIR)/sal-cdr-front-end.o: $(OBJ_DIR)/sal-cdr.o $(SRC_DIR)/sal-script-util.scm $(SRC_DIR)/front-end.macros

# Yices2 term/status values are int32 objects, not Bigloo fixnums.
# Keep generic arithmetic and checked foreign conversions in the FFI client.
$(OBJ_DIR)/sal-cdr.o: $(SRC_DIR)/sal-cdr.scm
	@mkdir -p $(OBJ_DIR)
	$(BIGLOO) $(filter-out -farithmetic -unsafe,$(BIGLOO_UNSAFE_FLAGS)) -eval '(define-macro (FILE-NAME) "sal-cdr.scm")' $< -o $@

$(OBJ_DIR)/%.o : $(SRC_DIR)/%.scm
	@mkdir -p $(OBJ_DIR)
	$(BIGLOO) $(BIGLOO_UNSAFE_FLAGS) -eval '(define-macro (FILE-NAME) "$*.scm")' $(SRC_DIR)/$*.scm -o $(OBJ_DIR)/$*.o

$(OBJ_SAFE_DIR)/%.o : $(SRC_DIR)/%.scm
	@mkdir -p $(OBJ_SAFE_DIR)
	$(BIGLOO) $(BIGLOO_SAFE_FLAGS) -eval '(define-macro (FILE-NAME) "$*.scm")' $(SRC_DIR)/$*.scm -o $(OBJ_SAFE_DIR)/$*.o

$(SRC_DIR)/%.sch:
	touch $@

$(OBJ_DIR)/%.mco: 
	@echo Generating check sum file \'$@\' ...
	@ $(BIGLOO) -fmco -mco -o $(OBJ_DIR)/$*.mco $(SRC_DIR)/$*.scm

$(OBJ_SAFE_DIR)/%.mco: 
	@echo Generating check sum file \'$@\' ...
	@ $(BIGLOO) -fmco -mco -o $(OBJ_SAFE_DIR)/$*.mco $(SRC_DIR)/$*.scm

$(OBJ_DIR)/%.o : $(SRC_DIR)/%.c
	@mkdir -p $(OBJ_DIR)
	$(CC) $(CPPFLAGS) $(CFLAGS) $(SRC_DIR)/$*.c -o $(OBJ_DIR)/$*.o -c


#*---------------------------------------------------------------------*/
#* Dependencies                                                        */
#*---------------------------------------------------------------------*/

$(OBJ_DIR)/Makefile.dependencies: $(ALL_SCM_SRC) $(SRC_DIR)/../Makefile
	@echo Making Scheme dependency file...
	@mkdir -p $(OBJ_DIR)
	@$(SHELL) -ec '(LD_LIBRARY_PATH=$(BIGLOOLIBDIR); export LD_LIBRARY_PATH; $(BDEPEND) -fno-jvm $(ALL_SCM_SRC) > $(OBJ_DIR)/Makefile.dependencies.tmp)'
	@$(SED) -e "s/trace.macros/trace.macros.in/g" $(OBJ_DIR)/Makefile.dependencies.tmp | \
	$(SED) -e "s,\([^\./ 	]*\)\.o:,$(SED_OBJ_DIR)/\1.o:,g" \
	-e "s,\([^\./ 	]*\)\.mco,$(SED_OBJ_DIR)/\1.mco,g" \
	-e "s,[^ 	]*/\([^\./ ]*\)\.o:,$(SED_OBJ_DIR)/\1.o:,g" \
	-e "s,[^ 	]*/\([^\./ ]*\)\.mco,$(SED_OBJ_DIR)/\1.mco,g" > $(OBJ_DIR)/Makefile.dependencies

$(OBJ_SAFE_DIR)/Makefile.dependencies: $(OBJ_DIR)/Makefile.dependencies
	@mkdir -p $(OBJ_SAFE_DIR)
	@ $(SED) -e "s/$(SED_OBJ_DIR)/$(SED_OBJ_SAFE_DIR)/g" $(OBJ_DIR)/Makefile.dependencies > $(OBJ_SAFE_DIR)/Makefile.dependencies

ifeq ($(MAKELEVEL),1)
include $(OBJ_DIR)/Makefile.dependencies
include $(OBJ_SAFE_DIR)/Makefile.dependencies
endif

#*---------------------------------------------------------------------*/
#*    .c ==> .d                                                        */
#*---------------------------------------------------------------------*/

$(OBJ_DIR)/%.d: $(SRC_DIR)/%.c
	@echo Making dependency file \'$@\' ... 
	@mkdir -p $(OBJ_DIR)
	@$(SHELL) -ec '$(CC) -MM $(CPPFLAGS) $< | $(SED) '\''s/\($*\)\.o[ :]*/$(SED_OBJ_DIR)\/\1.o $(SED_OBJ_DIR)\/\1.d : /g'\'' > $@; [ -s $@ ] || rm -f $@'
	@$(SED) -e "s/msgs.h//g;s/consts.h//g" $@ > $@.DEP.TMP
	@mv $@.DEP.TMP $@

ifeq ($(MAKELEVEL),1)
include $(SAL_C_FILE:%.c=$(OBJ_DIR)/%.d)
endif

#*---------------------------------------------------------------------*/
#* install                                                             */
#*---------------------------------------------------------------------*/
.PHONY: install 

install: 
	@ echo "SAL DOES NOT SUPPORT THIS ACTION"
	@ echo "--------------------------------"
	@ echo "If you want to install, you should create a binary installation package"
	@ echo ""
	@ echo " make binary-installation"

#*---------------------------------------------------------------------*/
#* distribution                                                        */
#*---------------------------------------------------------------------*/
.PHONY: binary-distribution source-distribution

binary-distribution:
	@ chmod +x distribution/build-binary-distribution.sh
	distribution/build-binary-distribution.sh

source-distribution:
	@ chmod +x distribution/build-source-distribution.sh
	distribution/build-source-distribution.sh


#*---------------------------------------------------------------------*/
#*    clean                                                            */
#*---------------------------------------------------------------------*/
.PHONY: clean global-clean common-clean

clean: common-clean
	rm -f $(SAL_CDR_BIN)
	rm -rf "$(OBJ_DIR)/yices2-ffi"
	rm -f $(SALENV_BIN)
	rm -f $(SALENV_SAFE_BIN)
	rm -f $(OBJ_DIR)/*
	rm -f $(OBJ_SAFE_DIR)/*
	rm -f $(SRC_DIR)/compilation-support-code.scm
	rm -f $(SRC_DIR)/sal-class-info.data
	rm -f $(SRC_DIR)/code-analyzer
	rm -f $(SRC_DIR)/gui/config.py $(SRC_DIR)/gui/version.py
	rm -f $(SRC_DIR)/doc/version.texi

global-clean: common-clean
	(cd bin;	ls -I CVS . | xargs rm -r -f)
	(cd obj; ls -I CVS . | xargs rm -r -f)
	(cd obj-safe; ls -I CVS . | xargs rm -r -f)

common-clean:
	rm -f *.tar.gz
	rm -f $(OBJ_DIR)/Makefile.dependencies*
	rm -f $(OBJ_SAFE_DIR)/Makefile.dependencies*
	find . -name 'core*' -exec rm -f '{}' ';'
	find . -name '.salenv_trace' -exec rm -f '{}' ';'
	find . -name 'a.out' -exec rm -f '{}' ';'
	find . -name '*.mco' -exec rm -f '{}' ';'

#*---------------------------------------------------------------------*/
#*   tags                                                              */
#*---------------------------------------------------------------------*/
.PHONY: tags

ifeq ($(MAKELEVEL),1)
tags: 
	etags -l none -r '/[ \t]*(define[ \t]+(?[^() \t]+[ \t)]/'  -r '/[ \t]*(define-class[ \t]+[^() \t]+[ \t)]/' -r '/[ \t]*(define-generic[ \t]+([^() \t]+[ \t)]/' -r '/[ \t]*(define-macro[ \t]+([^() \t]+[ \t)]/' -r '/[ \t]*(define-api[ \t]+([^() \t]+[ \t)]/' -r '/[ \t]*(define-bdd-proc[ \t]+[^() \t]+[ \t]+[^() \t]+[ \t]/' -r '/[ \t]*(define-bdd-op[ \t]+[^() \t]+[ \t]+[^() \t]+[ \t]/' -r '/[ \t]*(define-inline[ \t]+([^() \t]+[ \t)]/' -r '/[ \t]*(define-record-type[ \t]+[^() \t]+/' $(ALL_SCM_SRC) *.sch *.macros
else
tags:
	make -C src -f ../Makefile tags MAKELEVEL=1
endif
